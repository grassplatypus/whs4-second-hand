DATABASE_URL=postgresql://app:app@localhost:5432/app
JWT_ACCESS_SECRET=change_me_at_least_16_chars_long
AES_KEY=0123456789abcdef0123456789abcdef
BLIND_INDEX_KEY=change_me_blind_index_key_32chars
WS_PORT=4000
OAUTH_STATE_SECRET=change_me_oauth_state_secret_min16
APP_BASE_URL=http://localhost:3000
# MEDIA_DIR=./media        # 컨테이너에서는 /app/media (볼륨 마운트)
# GOOGLE_CLIENT_ID=...      # 없으면 Google도 목으로 동작
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
TWO_FACTOR_ISSUER=GrassSecondhand
# SMTP_HOST=...             # 없으면 이메일 OTP 발송도 목으로 동작
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# KAKAO_LOCAL_API_KEY=...   # 없으면 지오코딩도 목으로 동작
# OCTOMO_API_KEY=...        # 없으면 전화 OTP 발송도 목으로 동작
# OCTOMO_SENDER=...
NODE_ENV=development
# Reserved for chat/realtime (#4) — not wired into app code yet.
MONGO_URL=mongodb://mongo:27017/chat
