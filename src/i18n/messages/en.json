  "terms": {
    "title": "Terms of Service & Privacy Policy",
    "back": "Back",
    "s1Title": "1. Purpose",
    "s1Body": "These terms govern the secondhand trading service provided by Dongne Market (the 'Service'), including the rights and obligations of members. This Service is provided for demo purposes.",
    "s2Title": "2. Collection & Use of Personal Data",
    "s2Body": "The Service collects only your email, phone number, and nickname at signup. Email and phone are stored encrypted (AES-256-GCM). No detailed address is collected — only coarse neighborhood-level coordinates. Data is used solely for brokering trades and verifying identity.",
    "s3Title": "3. Location Data",
    "s3Body": "For radius search the Service uses only the approximate coordinates (2 decimal places) of your chosen neighborhood, and never stores or exposes your precise or real-time location.",
    "s4Title": "4. Escrow",
    "s4Body": "The escrow feature is provided as a demo; no real payment or settlement occurs. Disputes in real trades are the responsibility of the parties involved.",
    "s5Title": "5. Prohibited Conduct",
    "s5Body": "Members must not engage in abuse, defamation, fraud, or trading of illegal goods; violations may result in restriction (suspension) of service use.",
    "s6Title": "6. Withdrawal",
    "s6Body": "Members may withdraw at any time, but must complete any in-progress escrow or sales first. Personal data is destroyed without delay upon withdrawal."
  },
