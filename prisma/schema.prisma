generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUSPENDED
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  KAKAO
  NAVER
}

enum TwoFactorMethod {
  NONE
  TOTP
  EMAIL
}

enum OtpPurpose {
  LOGIN_2FA
  STEP_UP
  SETUP
}

enum ProductStatus {
  SELLING
  RESERVED
  SOLD
}

enum Category {
  DIGITAL
  APPLIANCE
  FURNITURE
  CLOTHING
  BOOK
  BEAUTY
  SPORTS
  ETC
}

model User {
  id               String          @id @default(cuid())
  nickname         String          @unique
  passwordHash     String? // OAuth-only 유저는 비번 없음(passwordless)
  emailCiphertext  String // AES-256-GCM
  emailBlindIndex  String          @unique // HMAC-SHA256(정규화 이메일)
  phoneCiphertext  String?
  phoneBlindIndex  String?
  bio              String?
  role             Role            @default(USER)
  lat              Float? // 동네 중심 좌표(거칠게). 지오코딩은 1b
  lng              Float?
  regionCiphertext String? // 동/읍/면 수준 주소만. 상세주소 미수집
  twoFactorMethod  TwoFactorMethod @default(NONE) // 설정·강제는 1a-ext
  totpSecret       String? // AES-GCM 암호화 저장. 구현은 1a-ext
  phoneVerifiedAt  DateTime? // 전화 인증 완료 시각. 구현은 1b
  consentedAt      DateTime
  deletedAt        DateTime? // soft delete(파기)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  identities       AuthIdentity[]
  emailOtps        EmailOtp[]
  phoneOtps        PhoneOtp[]
  products         Product[]

  @@index([phoneBlindIndex])
}

model AuthIdentity {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        OAuthProvider
  providerUserId  String
  emailAtProvider String?
  linkedAt        DateTime      @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String // 회전 체인(재사용 감지 단위)
  tokenHash    String    @unique // refresh 토큰 SHA-256
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model EmailOtp {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String // bcrypt 해시. 평문 코드 미저장
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model PhoneOtp {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneBlindIndex String
  codeHash        String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String // REGISTER|LOGIN|LOGIN_FAIL|REFRESH|REUSE_DETECTED|LOGOUT
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id            String         @id @default(cuid())
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  titleChoseong String
  description   String
  price         Int
  category      Category
  status        ProductStatus  @default(SELLING)
  lat           Float
  lng           Float
  regionLabel   String?
  directPlace   String?
  images        ProductImage[]
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, category, createdAt])
  @@index([sellerId])
  @@index([lat, lng])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  order     Int

  @@index([productId])
}
