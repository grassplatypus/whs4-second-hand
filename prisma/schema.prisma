generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUSPENDED
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  KAKAO
  NAVER
}

enum TwoFactorMethod {
  NONE
  TOTP
  EMAIL
}

enum OtpPurpose {
  LOGIN_2FA
  STEP_UP
  SETUP
}

enum ProductStatus {
  SELLING
  RESERVED
  SOLD
}

enum Category {
  DIGITAL
  APPLIANCE
  FURNITURE
  CLOTHING
  BOOK
  BEAUTY
  SPORTS
  ETC
}

enum EscrowStatus {
  REQUESTED // 요청·조정(금액 제안 왕복)
  ACCEPTED // 조정 완료(양측 금액 합의)
  FUNDED // 보관(구매자 입금, 에스크로 보관 중)
  RELEASED // 정산(판매자에게 대금 지급 — 거래 완료)
  REFUNDED // 반환(구매자에게 대금 반환)
  CANCELLED // 취소(입금 전 파기)
  DISPUTED // 분쟁(관리자 조정 대기 — 처리 UI는 #6)
}

model User {
  id               String          @id @default(cuid())
  nickname         String          @unique
  passwordHash     String? // OAuth-only 유저는 비번 없음(passwordless)
  emailCiphertext  String // AES-256-GCM
  emailBlindIndex  String          @unique // HMAC-SHA256(정규화 이메일)
  phoneCiphertext  String?
  phoneBlindIndex  String?
  bio              String?
  avatarPath       String? // 프로필 사진(media 경로). 없으면 닉네임 기반 이니셜 아바타로 폴백
  role             Role            @default(USER)
  lat              Float? // 동네 중심 좌표(거칠게). 지오코딩은 1b
  lng              Float?
  regionCiphertext String? // 동/읍/면 수준 주소만. 상세주소 미수집
  twoFactorMethod  TwoFactorMethod @default(NONE) // 설정·강제는 1a-ext
  totpSecret       String? // AES-GCM 암호화 저장. 구현은 1a-ext
  phoneVerifiedAt  DateTime? // 전화 인증 완료 시각. 구현은 1b
  consentedAt      DateTime
  deletedAt        DateTime? // soft delete(파기)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  identities       AuthIdentity[]
  emailOtps        EmailOtp[]
  phoneOtps        PhoneOtp[]
  products         Product[]
  escrowsAsBuyer   Escrow[]        @relation("EscrowBuyer")
  escrowsAsSeller  Escrow[]        @relation("EscrowSeller")
  reviewsWritten   TradeReview[]   @relation("ReviewAuthor")
  reviewsReceived  TradeReview[]   @relation("ReviewTarget")

  @@index([phoneBlindIndex])
}

model AuthIdentity {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        OAuthProvider
  providerUserId  String
  emailAtProvider String?
  linkedAt        DateTime      @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String // 회전 체인(재사용 감지 단위)
  tokenHash    String    @unique // refresh 토큰 SHA-256
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model EmailOtp {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String // bcrypt 해시. 평문 코드 미저장
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model PhoneOtp {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneBlindIndex String
  codeHash        String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String // REGISTER|LOGIN|LOGIN_FAIL|REFRESH|REUSE_DETECTED|LOGOUT
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id            String         @id @default(cuid())
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  titleChoseong String
  description   String
  price         Int
  category      Category
  status        ProductStatus  @default(SELLING)
  lat           Float
  lng           Float
  regionLabel   String?
  directPlace   String?
  images        ProductImage[]
  escrows       Escrow[]
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, category, createdAt])
  @@index([sellerId])
  @@index([lat, lng])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  order     Int

  @@index([productId])
}

model Escrow {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User          @relation("EscrowBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       String // 요청 시점 상품 판매자 스냅샷
  seller         User          @relation("EscrowSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  amount         Int // 현재 제안/합의 금액(원)
  status         EscrowStatus  @default(REQUESTED)
  lastProposerId String // 조정: 마지막 금액 제안자(상대가 수락)
  fundedAt       DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  meetupPlace    String? // 직거래 약속 장소(자유 텍스트, 동네 수준)
  meetupAt       DateTime? // 직거래 약속 시각
  events         EscrowEvent[]
  reviews        TradeReview[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId, status])
}

enum ReviewRating {
  GOOD // 좋아요
  OK // 보통
  BAD // 별로
}

/** 거래 후기 — 거래 완료(정산) 후 상대에게 남긴다. 공개 프로필에 표시. */
model TradeReview {
  id        String       @id @default(cuid())
  escrowId  String
  escrow    Escrow       @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User         @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  rating    ReviewRating
  comment   String?
  createdAt DateTime     @default(now())

  @@unique([escrowId, authorId]) // 한 거래당 한 사람 한 번
  @@index([targetId])
}

model EscrowEvent {
  id        String        @id @default(cuid())
  escrowId  String
  escrow    Escrow        @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  actorId   String // 행위자(구매자/판매자/관리자)
  from      EscrowStatus?
  to        EscrowStatus
  amount    Int? // 금액 조정·정산 시 기록
  note      String?
  createdAt DateTime      @default(now())

  @@index([escrowId])
}
